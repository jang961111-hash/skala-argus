# ReplaceFlow backend configuration (Security & Config Isolation point — see docs/CONTRACT.md)
# Database: SQLite for local dev, PostgreSQL/Supabase in prod
DATABASE_URL=sqlite:///./replaceflow.db
# AI provider: MOCK | LOCAL_LLM | AX_PLATFORM | OPENAI  (on-premise default: MOCK/LOCAL_LLM)
AI_PROVIDER=MOCK
# External data egress is disabled by default (on-premise assumption)
EGRESS_ALLOWED=false
OPENAI_API_KEY=
LOCAL_LLM_URL=
# If true, agent steps advance in a BackgroundTasks worker after POST; if false, each GET /agent-runs/{id} advances one step (CONTRACT mock behaviour)
BACKGROUND_ADVANCE=false
PROMPTS_PATH=../docs/05_ai_ready/prompts.md
CORS_ORIGINS=http://localhost:5173
