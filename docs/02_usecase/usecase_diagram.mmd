%% ReplaceFlow Use-Case Diagram v3.0 (flowchart LR, actors = rounded nodes, UCs = stadium)
flowchart LR
  %% ---------- Actors ----------
  VISITOR("미인증 방문자")
  ENG("설비 엔지니어<br/>ENGINEER")
  SM("안전관리자<br/>SAFETY_MANAGER")
  MON("모니터링 시스템<br/>(외부, Mock, 선택)")
  AGENTS("에이전트 서비스<br/>A1 / A2 / A3<br/>(Mock 또는 LLM)")

  %% ---------- System boundary ----------
  subgraph SYS["ReplaceFlow 시스템 v3.0 (FastAPI + Vue) — CONTRACT.md v3.0"]
    direction TB

    subgraph AUTH["인증 (API #1-3)"]
      direction LR
      UC01(["UC-01 회원가입<br/>#1 POST /auth/signup"])
      UC02(["UC-02 로그인·역할분기<br/>#2 /auth/login · #3 /auth/me"])
    end

    subgraph REGISTER["작업요청 등록"]
      direction LR
      UC03(["UC-03 요청 등록<br/>#5 create · #11 agent-runs"])
      UC04(["UC-04 임시저장<br/>#5 draft=true · #8 PATCH"])
      UC05(["UC-05 사진 업로드<br/>#9 upload · #10 list"])
    end

    subgraph AI["AI 검증·편집"]
      direction LR
      UC06(["UC-06 AI 검증(A1·A2·A3)<br/>#12 폴링 → allDone"])
      UC07(["UC-07 결과 확인·편집<br/>#13 PATCH agent-results"])
      UC08(["UC-08 제출<br/>#14 submit-approval → PENDING"])
    end

    subgraph APPROVAL["승인"]
      direction LR
      UC09(["UC-09 승인/거절<br/>#15 POST /approvals<br/>→ APPROVED / REJECTED"])
      UC10(["UC-10 사유 확인 후 재제출<br/>#14 재호출 → PENDING 복귀"])
    end

    subgraph VIEW["조회"]
      direction LR
      UC11(["UC-11 대시보드<br/>#4 summary"])
      UC12(["UC-12 내 요청 목록<br/>#6 list"])
    end
  end

  subgraph PHASE2["Phase 2 — v3.0 범위 외 (CONTRACT §8-10, §5)"]
    direction LR
    P_VENDOR("A4 벤더 에이전트")
    P_MASTER("법령·설비·부품 마스터, 호환표")
  end

  %% ---------- Associations ----------
  VISITOR --> UC01
  VISITOR --> UC02
  UC01 -. "가입 완료" .-> UC02

  MON -. "이상 알람(선택)" .-> UC03
  ENG --> UC03
  ENG --> UC04
  ENG --> UC05
  ENG --> UC07
  ENG --> UC08
  ENG --> UC10
  ENG -. "열람" .-> UC11
  ENG --> UC12

  SM --> UC09
  SM -. "열람(읽기전용 결과)" .-> UC11

  UC06 --> AGENTS

