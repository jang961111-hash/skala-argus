%% Argus End-to-End User Flow v3.0 (인증 → 등록 → AI 검증(A1/A2/A3) → 편집 → 승인/거절 → 재제출) — CONTRACT.md v3.0 상태 6종
flowchart TD
  START(["미인증 방문자 진입"])

  subgraph L_AUTH["인증 (API #1-3)"]
    direction TB
    AU1["회원가입 #1<br/>role: ENGINEER/SAFETY_MANAGER"]
    AU2["로그인 #2<br/>→ {accessToken, role, redirectPath}"]
    AU3{"redirectPath<br/>(서버가 결정)"}
  end

  subgraph L_ENG["설비 엔지니어 — 등록 (UC-03~05)"]
    direction TB
    E1["엔지니어 메인 (E_01)<br/>'신규 교체 요청'"]
    E2["요청 등록 (E_02)<br/>productType별 specJson 동적 폼 + 사진(files[])"]
    E2D{{"'임시 저장'?"}}
    S_DRAFT{{"status = DRAFT"}}
    E2S["'AI 검증 시작' #5(draft=false) → #11 agent-runs"]
  end

  subgraph L_AI["AgentOrchestrator + A1·A2·A3 (UC-06)"]
    direction TB
    S_RUN{{"status = AI_RUNNING"}}
    A1["A1 규격·호환<br/>specJson 적합성 판정 (부품 마스터 없음, Phase2)"]
    A2["A2 법령·조문<br/>정적 참고 조문 (법령 마스터 없음, Phase2)"]
    A3["A3 안전서류<br/>documents[] 초안"]
    POLL["FE 폴링 #12<br/>pollIntervalMs=2500"]
    FAILSTEP{{"step만 FAILED<br/>HTTP 200 유지"}}
    S_DONE{{"status = AI_DONE<br/>allDone = true"}}
  end

  subgraph L_ENG2["설비 엔지니어 — 결과 편집 (UC-07, UC-08)"]
    direction TB
    E4["결과 확인·수정 (E_04)<br/>items[]/documents[] 전체 치환 #13"]
    E5["engineerNote 작성 #8"]
    E7["'제출' #14 submit-approval<br/>(A1·A2·A3 존재 + note + A2 1건↑ + AI_DONE/REJECTED)"]
    E7X{{"422 SUBMIT_REQUIRED_FIELD_MISSING"}}
    S_PEND{{"status = PENDING"}}
  end

  subgraph L_SM["안전관리자 — 승인/거절 (UC-09)"]
    direction TB
    M0["요청 관리 (S_01) → 요청 상세 (S_02)"]
    M1["결과(읽기전용 editable=false)·사진·engineerNote 열람 #7 #10"]
    M3{"decision"}
    M4["#15 POST /approvals decision=APPROVE"]
    M4X{{"403 FORBIDDEN_ROLE / 409 NOT_PENDING·ALREADY_DECIDED"}}
    M5["#15 decision=REJECT + reason(10자↑)"]
    M5X{{"400 REJECT_REASON_REQUIRED"}}
    S_APR{{"status = APPROVED"}}
    S_REJ{{"status = REJECTED<br/>approvals 행 append-only 보존"}}
  end

  subgraph L_RESUB["설비 엔지니어 — 재제출 (UC-10)"]
    direction TB
    R1["내 요청 목록 (E_05) #6<br/>사유 확인"]
    R2["재편집 → E_04"]
  end

  DASH_E["엔지니어 메인 갱신 #4(engineer)"]
  DASH_S["안전관리자 요청관리 갱신 #4(safety)<br/>rejectReasonsTop"]

  %% ---------- Flow ----------
  START --> AU1 --> AU2
  START --> AU2
  AU2 --> AU3
  AU3 -- "ENGINEER → /home" --> E1
  AU3 -- "SAFETY_MANAGER → /manage/requests" --> M0

  E1 --> E2 --> E2D
  E2D -- "예" --> S_DRAFT
  S_DRAFT -. "'이어서' #8" .-> E2
  E2D -- "아니오" --> E2S --> S_RUN

  S_RUN --> A1
  S_RUN --> A2
  S_RUN --> A3
  A1 --> POLL
  A2 --> POLL
  A3 --> POLL
  POLL -- "일부 실패" --> FAILSTEP
  POLL -- "allDone:true" --> S_DONE

  S_DONE --> E4 --> E5 --> E7
  E7 -- "200" --> S_PEND
  E7 -- "422" --> E7X --> E5

  S_PEND --> M0 --> M1 --> M3
  M3 -- "승인" --> M4
  M4 -- "성공" --> S_APR
  M4 -- "실패" --> M4X --> M1
  M3 -- "거절" --> M5
  M5 -- "reason 10자↑" --> S_REJ
  M5 -- "reason 없음/짧음" --> M5X --> M5

  S_REJ --> R1 --> R2 --> E4
  S_APR --> DASH_E
  S_REJ --> DASH_S
  S_PEND -.-> DASH_S

  %% ---------- Styles ----------
  classDef status fill:#fff3bf,stroke:#e67700,stroke-width:1.5px,color:#222;
  classDef error fill:#ffe3e3,stroke:#c92a2a,stroke-width:1.5px,color:#222;
  classDef ai fill:#e6fcf5,stroke:#0b7285,stroke-width:1.5px,color:#222;
  classDef human fill:#ffffff,stroke:#333,stroke-width:1.2px,color:#222;
  class S_DRAFT,S_RUN,S_DONE,S_PEND,S_APR,S_REJ status;
  class FAILSTEP,E7X,M4X,M5X error;
  class A1,A2,A3,POLL ai;
  class AU1,AU2,AU3,E1,E2,E2D,E2S,E4,E5,E7,M0,M1,M3,M4,M5,R1,R2 human;
