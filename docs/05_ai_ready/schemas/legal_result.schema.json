{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://replaceflow.local/schemas/legal_result.schema.json",
  "title": "LegalResult — A2 법령 에이전트 출력",
  "type": "object",
  "description": "A2 법령 에이전트 결과 — 조문 인용 없는 항목 금지",
  "required": [
    "applicable_laws",
    "required_procedures"
  ],
  "properties": {
    "applicable_laws": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/LawCitation"
      }
    },
    "required_procedures": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/RequiredProcedure"
      }
    }
  },
  "$defs": {
    "LawCitation": {
      "type": "object",
      "required": [
        "law",
        "article",
        "title"
      ],
      "properties": {
        "law": {
          "type": "string",
          "examples": [
            "산업안전보건기준에 관한 규칙"
          ]
        },
        "article": {
          "type": "string",
          "examples": [
            "제92조"
          ]
        },
        "title": {
          "type": "string",
          "examples": [
            "정비등의 작업 시의 운전정지 등"
          ]
        },
        "quote": {
          "type": "string",
          "description": "법령 인덱스 원문 발췌 (빈 문자열 허용)",
          "examples": [
            "…운전을 정지하고 … 잠금장치 및 표지판을…"
          ]
        },
        "law_index_id": {
          "type": [
            "string",
            "null"
          ],
          "description": "law_index 테이블 ID (추적용)",
          "examples": [
            "LAW-0002"
          ]
        }
      }
    },
    "ProcedurePhase": {
      "type": "string",
      "description": "절차 시점 (작업 전 / 작업 중 / 작업 후)",
      "enum": [
        "BEFORE",
        "DURING",
        "AFTER"
      ],
      "examples": [
        "BEFORE"
      ]
    },
    "RequiredFlag": {
      "description": "필수 여부. 근거 조문을 찾지 못한 경우 `UNKNOWN` (안전관리자 확인 필요)",
      "oneOf": [
        {
          "type": "boolean"
        },
        {
          "type": "string",
          "enum": [
            "UNKNOWN"
          ]
        }
      ],
      "examples": [
        true
      ]
    },
    "RequiredProcedure": {
      "type": "object",
      "required": [
        "name",
        "phase",
        "required"
      ],
      "properties": {
        "name": {
          "type": "string",
          "examples": [
            "작업허가서(가스 배관 작업)"
          ]
        },
        "phase": {
          "$ref": "#/$defs/ProcedurePhase"
        },
        "required": {
          "$ref": "#/$defs/RequiredFlag"
        },
        "basis": {
          "type": [
            "string",
            "null"
          ],
          "description": "근거 조문 (예 \"산업안전보건기준에 관한 규칙 제92조\")",
          "examples": [
            "산업안전보건기준에 관한 규칙 제92조"
          ]
        },
        "note": {
          "type": [
            "string",
            "null"
          ],
          "description": "required=UNKNOWN 인 경우 안전관리자 확인 요청 문구"
        }
      }
    }
  },
  "examples": [
    {
      "applicable_laws": [
        {
          "law": "산업안전보건기준에 관한 규칙",
          "article": "제92조",
          "title": "정비등의 작업 시의 운전정지 등",
          "quote": "…운전을 정지하고 … 잠금장치 및 표지판을…"
        },
        {
          "law": "화학물질관리법",
          "article": "제24조",
          "title": "취급시설의 설치·관리 기준",
          "quote": ""
        },
        {
          "law": "고압가스 안전관리법 시행규칙",
          "article": "별표",
          "title": "특정고압가스 사용시설 기준",
          "quote": ""
        }
      ],
      "required_procedures": [
        {
          "name": "작업허가서(가스 배관 작업)",
          "phase": "BEFORE",
          "required": true
        },
        {
          "name": "위험성평가",
          "phase": "BEFORE",
          "required": true
        },
        {
          "name": "LOTO·가스 차단·퍼지 확인",
          "phase": "BEFORE",
          "required": true
        },
        {
          "name": "가스 감지기 정상 확인",
          "phase": "AFTER",
          "required": true
        }
      ]
    }
  ]
}
