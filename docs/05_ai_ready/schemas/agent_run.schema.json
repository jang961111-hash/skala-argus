{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://replaceflow.local/schemas/agent_run.schema.json",
  "title": "AgentRun — 오케스트레이터 실행 결과 (v3.0, agentCode A1/A2/A3)",
  "type": "object",
  "description": "CONTRACT v3.0 §4-12(폴링 응답: runId/workRequestId/status/allDone/pollIntervalMs/steps) + §4-7(WorkRequestDetail에 임베드될 때는 results도 포함, results[].editable은 SAFETY_MANAGER 조회 시 항상 false). steps는 정확히 3개, 순서 고정 A1→A2→A3. **실측(backend/app/schemas/agent.py AgentRunResponse/AgentRunDetail)**: 응답에 run의 PK가 `id`와 `runId` 이름으로 중복 노출된다(SQLAlchemy PK 관례 + CONTRACT 계약 필드명을 함께 유지).",
  "required": [
    "id",
    "runId",
    "workRequestId",
    "status",
    "allDone",
    "pollIntervalMs",
    "steps"
  ],
  "properties": {
    "id": {
      "type": "string",
      "description": "run의 PK. runId와 동일 값(실측: AgentRunResponse.id).",
      "examples": [
        "b7e6c1d2-3a4b-4c5d-8e9f-000000000001"
      ]
    },
    "runId": {
      "type": "string",
      "description": "UUID v4 — CONTRACT §1 'WR- 같은 접두어 ID를 쓰지 않는다'. id와 동일 값.",
      "examples": [
        "b7e6c1d2-3a4b-4c5d-8e9f-000000000001"
      ]
    },
    "workRequestId": {
      "type": "string",
      "examples": [
        "a1b2c3d4-1111-4222-8333-000000000099"
      ]
    },
    "status": {
      "$ref": "#/$defs/RunStatus"
    },
    "allDone": {
      "type": "boolean",
      "description": "3개 step 모두 DONE이면 true. true가 되면 프론트는 폴링을 중단하고, 서버는 work_requests.status를 AI_DONE으로 전환한다.",
      "examples": [
        true
      ]
    },
    "pollIntervalMs": {
      "type": "integer",
      "const": 2500,
      "description": "서버가 내려주는 폴링 주기(ms). CONTRACT §4-12 고정값. 실측: Settings.poll_interval_ms 기본값 2500.",
      "examples": [
        2500
      ]
    },
    "startedAt": {
      "type": [ "string", "null" ],
      "format": "date-time"
    },
    "finishedAt": {
      "type": [ "string", "null" ],
      "format": "date-time"
    },
    "steps": {
      "type": "array",
      "description": "고정 3개, 순서 A1 → A2 → A3",
      "minItems": 3,
      "maxItems": 3,
      "items": false,
      "prefixItems": [
        { "allOf": [ { "$ref": "#/$defs/AgentStep" }, { "properties": { "agentCode": { "const": "A1" } } } ] },
        { "allOf": [ { "$ref": "#/$defs/AgentStep" }, { "properties": { "agentCode": { "const": "A2" } } } ] },
        { "allOf": [ { "$ref": "#/$defs/AgentStep" }, { "properties": { "agentCode": { "const": "A3" } } } ] }
      ]
    },
    "results": {
      "description": "WorkRequestDetail(API#7)에 임베드될 때만 존재(AgentRunDetail). 폴링 응답(API#12, AgentRunResponse) 단독으로는 없다(null 허용). 존재하면 steps와 동일하게 3개, 순서 A1→A2→A3.",
      "anyOf": [
        {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "items": false,
          "prefixItems": [
            { "allOf": [ { "$ref": "#/$defs/AgentResult" }, { "properties": { "agentCode": { "const": "A1" } } } ] },
            { "allOf": [ { "$ref": "#/$defs/AgentResult" }, { "properties": { "agentCode": { "const": "A2" } } } ] },
            { "allOf": [ { "$ref": "#/$defs/AgentResult" }, { "properties": { "agentCode": { "const": "A3" } } } ] }
          ]
        },
        { "type": "null" }
      ]
    }
  },
  "$defs": {
    "RunStatus": {
      "type": "string",
      "enum": [ "RUNNING", "DONE", "FAILED" ],
      "examples": [ "DONE" ]
    },
    "AgentStepStatus": {
      "type": "string",
      "enum": [ "WAITING", "RUNNING", "DONE", "FAILED" ],
      "examples": [ "DONE" ]
    },
    "AgentCode": {
      "type": "string",
      "description": "A1 규격·호환 / A2 법령·조문 / A3 안전서류. A4(벤더)는 Phase 2, 이 enum에 없다.",
      "enum": [ "A1", "A2", "A3" ],
      "examples": [ "A1" ]
    },
    "AgentStep": {
      "type": "object",
      "required": [ "agentCode", "status" ],
      "properties": {
        "agentCode": { "$ref": "#/$defs/AgentCode" },
        "status": { "$ref": "#/$defs/AgentStepStatus" },
        "message": {
          "type": [ "string", "null" ],
          "maxLength": 200,
          "description": "실측: Mock 에이전트는 '규격·호환 검토 완료' 류의 완료 메시지만 채운다(진행 중 메시지는 아직 없음).",
          "examples": [ "규격·호환 검토 완료" ]
        },
        "errorMessage": {
          "type": [ "string", "null" ],
          "description": "status=FAILED일 때만. 다른 step이 FAILED여도 이 step은 계속 진행될 수 있다(CONTRACT §4-12, HTTP 200 유지).",
          "examples": [ null ]
        },
        "startedAt": {
          "type": [ "string", "null" ],
          "format": "date-time",
          "examples": [ "2026-09-03T15:10:03+09:00" ]
        },
        "finishedAt": {
          "type": [ "string", "null" ],
          "format": "date-time",
          "examples": [ "2026-09-03T15:10:20+09:00" ]
        }
      },
      "allOf": [
        {
          "if": { "properties": { "status": { "enum": [ "WAITING", "RUNNING" ] } }, "required": [ "status" ] },
          "then": { "properties": { "finishedAt": { "const": null } } }
        }
      ]
    },
    "ResultItem": {
      "type": "object",
      "description": "실측: itemId는 UUID가 아니라 `i-01` 형식 순번 코드(agent_result_items.schema.json과 동일 정의).",
      "required": [ "text" ],
      "properties": {
        "itemId": { "type": [ "string", "null" ], "examples": [ "i-01" ] },
        "text": { "type": "string", "minLength": 1 },
        "edited": { "type": "boolean", "default": false }
      }
    },
    "ResultDocument": {
      "type": "object",
      "description": "실측: docId는 `d-01` 형식 순번 코드(agent_result_documents.schema.json과 동일 정의).",
      "required": [ "type", "name", "content" ],
      "properties": {
        "docId": { "type": [ "string", "null" ], "examples": [ "d-01" ] },
        "type": { "type": "string" },
        "name": { "type": "string", "minLength": 1 },
        "content": { "type": "string" },
        "edited": { "type": "boolean", "default": false }
      }
    },
    "ItemsPayload": {
      "type": "object",
      "required": [ "items" ],
      "properties": {
        "items": { "type": "array", "items": { "$ref": "#/$defs/ResultItem" } }
      }
    },
    "DocumentsPayload": {
      "type": "object",
      "required": [ "documents" ],
      "properties": {
        "documents": { "type": "array", "items": { "$ref": "#/$defs/ResultDocument" } }
      }
    },
    "AgentResult": {
      "type": "object",
      "description": "agent_results 행 — 실측(backend/app/schemas/agent.py AgentResultResponse) 기준. items/documents는 결과 객체에 바로 달리지 않고 **payloadJson 안에 감싸인다**: agentCode=A1/A2 → payloadJson={items:[...]}, A3 → payloadJson={documents:[...]}. id와 agentResultId는 동일 값(PK 중복 노출, agent_run 최상위 id/runId와 같은 패턴).",
      "required": [ "id", "agentResultId", "agentCode", "payloadJson", "edited", "editable" ],
      "properties": {
        "id": { "type": "string" },
        "agentResultId": { "type": "string", "description": "id와 동일 값." },
        "agentCode": { "$ref": "#/$defs/AgentCode" },
        "editable": {
          "type": "boolean",
          "description": "현재 조회 주체가 이 결과를 PATCH 가능한지. SAFETY_MANAGER 조회 시 항상 false(CONTRACT §4-7, 실측: run_to_detail(editable=...) 호출부에서 라우터가 role로 고정). ENGINEER는 status가 AI_DONE/REJECTED일 때만 true(RESULT_EDITABLE_STATUSES).",
          "examples": [ true ]
        },
        "edited": {
          "type": "boolean",
          "description": "agent_results.edited 컬럼 — 이 행(에이전트 결과 전체)이 한 번이라도 편집됐는지의 row-level 플래그. 항목별 edited와 별개로, 빠른 조회·집계용.",
          "default": false
        },
        "updatedAt": {
          "type": [ "string", "null" ],
          "format": "date-time"
        },
        "payloadJson": {
          "description": "agentCode가 A1/A2면 ItemsPayload({items:[...]}), A3면 DocumentsPayload({documents:[...]}).",
          "anyOf": [ { "$ref": "#/$defs/ItemsPayload" }, { "$ref": "#/$defs/DocumentsPayload" } ]
        }
      },
      "allOf": [
        {
          "if": { "properties": { "agentCode": { "enum": [ "A1", "A2" ] } }, "required": [ "agentCode" ] },
          "then": { "properties": { "payloadJson": { "$ref": "#/$defs/ItemsPayload" } } }
        },
        {
          "if": { "properties": { "agentCode": { "const": "A3" } }, "required": [ "agentCode" ] },
          "then": { "properties": { "payloadJson": { "$ref": "#/$defs/DocumentsPayload" } } }
        }
      ]
    }
  },
  "examples": [
    {
      "id": "b7e6c1d2-3a4b-4c5d-8e9f-000000000001",
      "runId": "b7e6c1d2-3a4b-4c5d-8e9f-000000000001",
      "workRequestId": "a1b2c3d4-1111-4222-8333-000000000099",
      "status": "DONE",
      "allDone": true,
      "pollIntervalMs": 2500,
      "startedAt": "2026-09-03T15:10:02+09:00",
      "finishedAt": "2026-09-03T15:11:05+09:00",
      "steps": [
        { "agentCode": "A1", "status": "DONE", "message": "규격·호환 검토 완료", "errorMessage": null, "startedAt": "2026-09-03T15:10:03+09:00", "finishedAt": "2026-09-03T15:10:20+09:00" },
        { "agentCode": "A2", "status": "DONE", "message": "적용 법령 검토 완료", "errorMessage": null, "startedAt": "2026-09-03T15:10:20+09:00", "finishedAt": "2026-09-03T15:10:45+09:00" },
        { "agentCode": "A3", "status": "DONE", "message": "안전서류 초안 생성 완료", "errorMessage": null, "startedAt": "2026-09-03T15:10:45+09:00", "finishedAt": "2026-09-03T15:11:05+09:00" }
      ],
      "results": [
        {
          "id": "c1a2b3d4-0001-4000-8000-000000000001",
          "agentResultId": "c1a2b3d4-0001-4000-8000-000000000001",
          "agentCode": "A1",
          "editable": true,
          "edited": false,
          "updatedAt": "2026-09-03T15:10:20+09:00",
          "payloadJson": {
            "items": [
              { "itemId": "i-01", "text": "입력 스펙(압력 등급 3000 psi)이 요구치(2500 psi) 이상으로 적합합니다.", "edited": false }
            ]
          }
        },
        {
          "id": "c1a2b3d4-0002-4000-8000-000000000002",
          "agentResultId": "c1a2b3d4-0002-4000-8000-000000000002",
          "agentCode": "A2",
          "editable": true,
          "edited": false,
          "updatedAt": "2026-09-03T15:10:45+09:00",
          "payloadJson": {
            "items": [
              { "itemId": "i-01", "text": "산업안전보건기준에 관한 규칙 제92조(정비등의 작업 시의 운전정지 등) — 정비·교체 작업 전 운전을 정지하고 기동장치에 잠금장치와 표지판을 설치한다.", "edited": false }
            ]
          }
        },
        {
          "id": "c1a2b3d4-0003-4000-8000-000000000003",
          "agentResultId": "c1a2b3d4-0003-4000-8000-000000000003",
          "agentCode": "A3",
          "editable": true,
          "edited": true,
          "updatedAt": "2026-09-03T15:12:00+09:00",
          "payloadJson": {
            "documents": [
              { "docId": "d-01", "type": "WORK_PERMIT", "name": "작업허가서 초안", "content": "# 작업허가서\n\n- 설비: 가스캐비닛#2\n- 작업자: 김민준, 이영수", "edited": true }
            ]
          }
        }
      ]
    }
  ]
}
